# Environment Variables for Next.js Frontend (Local Mode - HTTPS)
# Ports: Frontend 3000, Core API 5000, AI Service 8000

# NextAuth Configuration
NEXTAUTH_URL=https://localhost:3000
NEXTAUTH_SECRET=local-dev-nextauth-secret-key-32-characters

# Server-side API URLs (for SSR)
NEXT_PUBLIC_API_URL=https://localhost:5000
NEXT_PUBLIC_AI_SERVICE_URL=https://localhost:8000
